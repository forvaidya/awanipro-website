# =============================================================================
# AwaniPro Website - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values
# For Cloudflare Pages deployment: Set these in CF Dashboard → Settings → Env Vars
# =============================================================================

# Application Environment
NODE_ENV=production

# Deployment Target
VITE_DOMAIN=www.awanipro.com
VITE_ENVIRONMENT=production
VITE_APP_URL=https://www.awanipro.com

# API Configuration (for future backend integration)
VITE_API_URL=https://api.awanipro.com
VITE_API_TIMEOUT=10000

# Base URL Configuration
# Leave empty for root-relative paths (works on any domain)
# Set to full domain URL if you need absolute URLs
# VITE_BASE_URL=https://your-domain.com

# Contact Form - Web3Forms Integration
# Get this from: https://web3forms.com
# This is a PUBLIC key - domain validation provides security
# Leave empty if contact form disabled
VITE_WEB3FORMS_KEY=your_web3forms_access_key_here
VITE_CONTACT_EMAIL=hello@awanipro.com

# Analytics (optional - Cloudflare Analytics enabled by default)
# VITE_GA_MEASUREMENT_ID=G_XXXXXXXXXX

# Feature Flags (for future use)
VITE_ENABLE_BLOG=true
VITE_ENABLE_CONTACT_FORM=true

# =============================================================================
# CLOUDFLARE PAGES DEPLOYMENT INSTRUCTIONS
# =============================================================================
# 
# 1. Set environment variables in Cloudflare Dashboard:
#    → Select your Pages project
#    → Settings → Environment variables
#    → Add Production environment:
#      - NODE_ENV = production
#      - VITE_DOMAIN = www.awanipro.com
#      - VITE_API_URL = https://api.awanipro.com
#      - VITE_WEB3FORMS_KEY = your_actual_key
#
# 2. Build and deploy:
#    → Push to GitHub main branch
#    → Cloudflare auto-builds and deploys
#    → Monitor: CF Dashboard → Pages → Deployments
#
# 3. Verify deployment:
#    → Visit https://www.awanipro.com
#    → Check SSL: 🔒 Green lock
#    → Test all pages and forms
#
# =============================================================================
